{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hajimu.jp/schemas/hajimu-registry-v1.json",
  "title": "Hajimu package registry",
  "type": "object",
  "required": ["schema_version", "packages"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schema_version": { "const": 1 },
    "packages": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["version", "source", "description"],
        "properties": {
          "version": { "type": "string" },
          "source": { "type": "string", "not": { "pattern": "^http://" } },
          "description": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
